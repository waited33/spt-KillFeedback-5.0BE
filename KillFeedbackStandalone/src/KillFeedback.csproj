<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>KillFeedback</AssemblyName>
    <RootNamespace>KillFeedback</RootNamespace>
    <Version>5.0.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DebugType>none</DebugType>
    <GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
    <GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
    <!-- Il2CppInterop assemblies redeclare some BCL types; the duplicate-type warnings are
         expected and harmless for a BepInEx 6 IL2CPP plugin. -->
    <NoWarn>$(NoWarn);CS0436;CS0437;CS0067;CS0169</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Point this at the client root (the folder holding EscapeFromTarkov.exe). -->
    <SptPath Condition="'$(SptPath)' == ''">E:\SPT-AK\Client.1.3.0.1.48558</SptPath>
    <BepInExCore>$(SptPath)\BepInEx\core</BepInExCore>
    <InteropPath>$(SptPath)\BepInEx\interop</InteropPath>
    <PluginFolder>$(SptPath)\BepInEx\plugins\KillFeedback-5.0BE</PluginFolder>
  </PropertyGroup>

  <ItemGroup>
    <!-- BepInEx 6 for IL2CPP (the client hosts a net10.0 CoreCLR) -->
    <Reference Include="BepInEx.Core">
      <HintPath>$(BepInExCore)\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(BepInExCore)\BepInEx.Unity.IL2CPP.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.Common">
      <HintPath>$(BepInExCore)\BepInEx.Unity.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(BepInExCore)\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Common">
      <HintPath>$(BepInExCore)\Il2CppInterop.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Game assemblies, as generated by Il2CppInterop (stubs, not the game's IL) -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(InteropPath)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- EBodyPart and EDamageType live in their own assembly on this client. -->
    <Reference Include="PlayerEnums">
      <HintPath>$(InteropPath)\PlayerEnums.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Comfort">
      <HintPath>$(InteropPath)\Comfort.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(InteropPath)\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSystem">
      <HintPath>$(InteropPath)\Il2CppSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(InteropPath)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(InteropPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(InteropPath)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(InteropPath)\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(InteropPath)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(InteropPath)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(InteropPath)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(InteropPath)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- The kill HUD prefab bundle. Unity drops the prefab's custom scripts while loading (they
         belong to an assembly the game does not have), so the layout, animators and TMP texts are
         reused as-is and the behaviour is re-attached at runtime. -->
    <None Remove="..\bundle\gamepanelkillhud.bundle" />
    <EmbeddedResource Include="..\bundle\gamepanelkillhud.bundle">
      <LogicalName>KillFeedback.gamepanelkillhud.bundle</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Copies the built plugin into the local SPT install for testing -->
  <Target Name="CopyToSpt" AfterTargets="Build" Condition="Exists('$(SptPath)\BepInEx\plugins')">
    <MakeDir Directories="$(PluginFolder)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginFolder)" ContinueOnError="true" />
    <Copy SourceFiles="..\bundle\gamepanelkillhud.bundle" DestinationFolder="$(PluginFolder)" ContinueOnError="true" />
  </Target>

</Project>
